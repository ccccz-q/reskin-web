# ═══════════════════════════════════════════════════════════
# 复制这个文件为 .env 后填入真实值：  cp .env.example .env
#
# ⚠ .env 已在 .gitignore 里 —— 密钥永远不要进仓库。
# ═══════════════════════════════════════════════════════════


# ── 对话模型（火山方舟 · DeepSeek 接入点）─────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 在方舟控制台创建推理接入点后，这里填接入点 ID（不是基础模型名）
DEEPSEEK_MODEL=

# ── 生图模型（火山方舟 · Seedream）────────────────────────
SEEDREAM_API_KEY=
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=

# ── 视觉模型（可选，但强烈建议配）─────────────────────────
# 用于 extract_card：从原图提炼「主体 / 视觉锚点 / 风险点」。
# 不配也能跑 —— 那时只做本地 Pillow 取色（0 成本），
# 但「反推 forbid」这条保真机制会降级为通用约束，强度明显下降。
# 填方舟上支持视觉的接入点 ID（如 doubao-seed-1-6 系列）。
VISION_MODEL=

# ── 服务端口 ─────────────────────────────────────────────
# 刻意默认只监听本机。需要局域网访问时改成 0.0.0.0 并自行评估风险
# （那时请务必同时配置下面的 LOCAL_TOKEN）。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 允许访问后端的前端来源（逗号分隔）。dev 端口要在这里，否则被 CORS 拒绝。
# 这个白名单同时是**写操作的 Origin 闸门**：不在列表里的来源，
# 连 POST 都会被 403 —— 用来挡「恶意网页对你的 localhost 发请求」。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 访问令牌（可选）──────────────────────────────────────
# 留空 = 不校验令牌（默认只监听 127.0.0.1，风险面已收在本机）。
# 要把后端暴露到局域网 / 内网演示时，填一个随机串，前端需在
# frontend/.env 里配 VITE_LOCAL_TOKEN=<同一个值>。
# 生成一个：python -c "import secrets;print(secrets.token_urlsafe(32))"
LOCAL_TOKEN=

# ═══════════════════════════════════════════════════════════
# 治理护栏 —— 这几项是「花出去的钱」和「能不能被玩坏」的最后一道闸
# ═══════════════════════════════════════════════════════════

# 单个会话在额度重置前最多生成多少张（防止一次 demo 把额度跑光）
MAX_GENERATIONS_PER_SESSION=5

# Agent 单轮最多走几步（防止 LLM 死循环烧钱）
MAX_AGENT_STEPS=8

# 工具返回结果喂回模型的最大字符数（防止提示词把下一轮输入撑爆）
MAX_TOOL_OBSERVATION_CHARS=2000

# SSE 同时进行的对话上限。每条流占一条线程 + 一次付费 Agent 循环，
# 不设上限的话「多开几个标签页」就是把额度打光的捷径。
MAX_SSE_CONCURRENCY=4

# 单个参数值的最大字符数（防止有人往 string 参数里塞长篇大论放大 token 成本）
MAX_PARAM_CHARS=300

# 生成图下载的体积上限（字节）。下载 URL 来自远端响应，必须设上限。
MAX_DOWNLOAD_BYTES=26214400

# 允许下载生成图的主机后缀（逗号分隔）—— 这是一道 SSRF 白名单。
# 默认值与火山方舟实际用的 CDN 一致；换服务商时改这里。
DOWNLOAD_HOST_SUFFIXES=.volces.com,.volcengineapi.com,.byteimg.com,.byteimg.cn

# 解码上限：Pillow 默认阈值是 8948 万像素，且超阈值 1~2 倍只发警告不报错，
# 等于留了个 0.67GB 内存的静默窗口。这里压到 4000 万。
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_SIDE=12000

# 上传体积上限（字节），默认 20MB
MAX_UPLOAD_BYTES=20971520

# 外部调用超时（秒）
REQUEST_TIMEOUT_SEC=60

# ── 收尾文案（出图成功后模型写的那段说明）的等待预算 ──────────────
#   这段只是说明文字，图早已生成落盘，所以等待上限远低于主链路。
#   单次上限 + 总预算硬闸 + 3 次尝试（0/1.5/3s 退避），
#   最坏约 51.5 秒；上游正常时首次即中，约 3–8 秒。
#   总预算这条是「不超过 1 分钟」红线的执行者——调大它就会破线。
FINAL_SUMMARY_ATTEMPT_TIMEOUT_SEC=25
FINAL_SUMMARY_TOTAL_BUDGET_SEC=55

# ── 小助手（页面右下角问答）的等待预算 ──────────────────────
#   同样是「用户在屏幕前等着」的场景，不能套批量流水线的容错
#   （全局 REQUEST_TIMEOUT_SEC 是给工坊那种一次跑 8–9 次调用定的）。
#   排期：主通道 2 次（0/1s 退避）+ 兜底通道 1 次，最坏 3×18+1 = 55 秒。
#   ★ 改这三个值时必须满足：3 × ATTEMPT + 1 ≤ BUDGET，否则兜底那一次会被
#     预算挤掉（主通道一死小助手就整个不可用）。有单测守着这条式子。
HELPER_ATTEMPT_TIMEOUT_SEC=18
HELPER_TOTAL_BUDGET_SEC=60
# 小助手看图：带图比纯文本慢，给到 30s；默认不套全局超时
HELPER_VISION_TIMEOUT_SEC=30

# ── Agent 护栏（自建Tool-use Loop 的"不许乱来"边界）────────────────
#   ★ 2026-10-06 统一口径：此前这几个数硬编码在 engine/loop.py 顶部，
#     而MAX_AGENT_STEPS 在 config 里 env 化 —— 同一件事两套口径，
#     调参的人会以为"改 env 就能调所有护栏"。现在全都能用 env 调。
MAX_AGENT_STEPS=8                # 单轮最多几步工具调用
MAX_TOOL_OBSERVATION_CHARS=2000  # 单条工具结果进prompt 的长度上限
HISTORY_LIMIT=20                 # 喂给模型的最大历史条数
REPEAT_FUSE=2                    # 同一签名（工具名+参数）连续重复几次就熔断
MEMORY_TRIGGER=12                # 消息数超过多少触发一次长期记忆更新

# ── 上下文 token 预算（按条数裁剪的**补充**，不是替代）────────────
#   20 条长消息的 token 量可能顶得上 200 条短消息 ——
#   条数达标但 token 爆掉，上游会直接拒绝整轮请求。
#   两道闸一起上：先按条数砍到 HISTORY_LIMIT，再按估算 token 砍到本预算。
#   估算是保守的字符法（中文 1 字≈1 token，其余 4 字符≈1 token），
#   宁可少留也不要超。设 0 = 关闭这道闸，只按条数裁剪。
CONTEXT_TOKEN_BUDGET=12000

# ★ 演示总开关：置为 1 时全局禁止出图，但预览 / 调参 / 渲染提示词照常可用。
#   答辩投屏、临时借电脑给别人的时候建议打开。
DISABLE_IMAGE_GENERATION=0

# ═══════════════════════════════════════════════════════════
# 路径覆盖 —— 一般不需要动
# 留空 = 使用默认值（项目/storage/...），全部由 __file__ 推导，与启动目录无关。
# 这两个就是当年「项目里出现两份 storage」的根因，现在不再需要靠手动改来补救。
# ═══════════════════════════════════════════════════════════
STORAGE_DIR=
IMAGE_STORAGE_DIR=
SQLITE_DIR=

# 已废弃项（保留作记录，当前代码不再读取）：
#   VECTOR_DB_DIR —— ChromaDB 已按 §0 决策 6 移除，上下文检索改用 SQLite FTS5
#   SQLITE_PATH   —— 现在由 SQLITE_DIR + agent.db 推导
