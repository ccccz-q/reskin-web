# ═══════════════════════════════════════════════════════════
# .gitignore —— 什么该进版本库，什么坚决不进
# ═══════════════════════════════════════════════════════════

# ── 密钥与本地配置（最要紧的一条）────────────────────
.env
.env.*
!.env.example
.env.bak*

# ── 依赖与构建产物 ──────────────────────────────────
node_modules/
frontend/dist/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 运行期数据：用户图片、数据库、审计日志 ───────────
storage/
backend/storage/
logs/
*.log
*.db
*.db-wal
*.db-shm

# ── 本地调试/走查脚本产物 ────────────────────────────
backend/_*.py
backend/tests/_img_tmp/
backend/tests/_*.png
backend/_*.mjs
backend/*.log
backend/tests/*.log
backend/tests/run_all.log
frontend/.playwright-cli/
.playwright-cli/
ux_*.png
start_*.png
now.yaml
page-*.yml
*.bak*

# ── 归档（个人测试数据，不进库）─────────────────────
_archive_*/

# ── 编辑器与系统 ────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 临时文件 ────────────────────────────────────────
_t/
*.tmp

# ── 发布产物副本（打包器输出，可由 deploy/build_release.py 重新生成）──
# ★ 2026-10-06 改通配：原来只写死 deploy/release/，于是新目录
#   deploy/release_20261006/（打包器 RELEASE_OUT 用）差点连同真实 .env 入库。
#   教训：产物目录的名字会变，忽略规则不能跟着一个个补。
deploy/release*/
deploy/publish_*/

# ★ 2026-10-06 修正：下面两行原来是 "!deploy/public_storage/" 与 "!deploy/*.png"
#   （反向规则 = 强制入库），于是 28 个公共素材文件 + 5 张一次性截图一直被跟踪，
#   .git 撑到 49MB。已 git rm --cached 移出索引（磁盘文件保留）。
#   判断标准是「是不是可再生的产物」，而不是「是不是打包器的输入」：
#     · public_storage/ 的种子图是运行期生成物的副本，可由后端重新产出；
#     · deploy/*.png 是 S3 联调 / TOTP 调试的一次性截图，没有复用价值。
#   只保留打包器与清洗脚本本身（那是源）。
deploy/public_storage/
deploy/*.png
!deploy/build_release.py
!deploy/prepare_public.py

# ── 覆盖率产物（2026-10-08）───────────────────────────────
# 为什么不写死目录名：.coveragerc 里 html 目录写的是 ../docs/coverage，
#   但 coverage 还会产出 .coverage 数据文件在**运行目录**（backend/）。
#   两个位置、名字都可能随配置变，所以按**文件形态**忽略更稳。
.coverage
.coverage.*
coverage.xml
htmlcov/
docs/coverage/

# ── 浏览器冒烟截图（失败时才生成，SMOKE_SHOT_DIR 指定）────────
# 路径由 CI 传进来，属于可再生产物。
_smoke_artifacts/
backend/_smoke_artifacts/

# ── 推送尝试的临时载荷（2026-10-08）────────────────────────
# 上次用 MCP push_files 尝试推送时留下的空文件。
# 它只有2 字节但会被当成"要提交的新文件"，容易误入。
.push_payload.json
backend/_cov_html/

# ── 效果证据的原始产物（2026-10-08）──────────────────────
# docs/gallery/*.png 是生成物，单张 2-3MB、11 张共 22MB。
# 入库的是 docs/compare/*.webp（约 150KB，两组对比 + 一组消融），
# 原始 PNG 可由 `python tests/evidence_run.py` 重新跑出来。
# 判断依据是「能不能再生」：能再生的就不入库 —— 与 deploy/public_storage 同一条标准。
docs/gallery/
docs/gallery_webp/
docs/evidence/ablation/
