# ═══════════════════════════════════════════════════════════
# .gitignore —— 什么该进仓库，什么不该，写清楚理由
# ═══════════════════════════════════════════════════════════

# ── 密钥 ─────────────────────────────────────────────────
.env
.env.*
!.env.example          # 模板要进仓库（里面没有真实值）

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
*.sqlite3

# ── 运行时产物 ────────────────────────────────────────────
# 用户上传 / 生成的图片，以及 SQLite 与审计日志：都不是源码
storage/
backend/storage/
logs/
*.log

# 历史遗留：LangGraph 的 SqliteSaver 曾在这里留下一个 678MB 的 agent.db，
# 这类「运行时数据库」本来就不该跟着项目走。
*.db
*.db-wal
*.db-shm

# ── 前端 ─────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
.vite/

# ── 编辑器 / 系统 ─────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 临时文件 ─────────────────────────────────────────────
_t/
*.tmp

# .env 备份（改动前的快照，含真实密钥，绝不入库）
.env.bak*
